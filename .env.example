# Environment Configuration
PROJECT_NAME="EVE Healthcare API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
# For local Postgres: postgresql://eve_user:eve_password@localhost:5432/eve_healthcare_db
# For SQLite (zero setup fallback): sqlite:///./eve_healthcare.db
DATABASE_URL="postgresql://eve_user:eve_password@localhost:5432/eve_healthcare_db"

# Redis Cache Configuration
REDIS_URL="redis://localhost:6379/0"
CACHE_ENABLED=True
CACHE_DEFAULT_TTL_SECONDS=300

# Security & JWT Configuration
JWT_SECRET_KEY="super-secret-eve-healthcare-jwt-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
